# Copy to .env and fill in real values. .env is git-ignored; this file is not,
# so only ever put dummy values here.
API_BASE_URL=https://example.org/api
API_TIMEOUT_SECONDS=10
DATA_DIR=data
LOG_LEVEL=INFO
# LLM_API_KEY=replace-me

# Databricks, used by dbt. Dummy values only in this file.
# The real token lives in ~/.databrickscfg, outside the repository.
DATABRICKS_HOST=dbc-xxxxxxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxx
DATABRICKS_TOKEN=replace-me
