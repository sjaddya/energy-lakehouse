# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Secrets: never commit. .env.example documents the variables instead.
.env
*.pem
*.key

# Local data: keep the folder, not its contents
data/*
!data/.gitkeep

# dbt: build artefacts and logs, never the project files
dbt/target/
dbt/logs/
dbt/dbt_packages/
# dbt resolves its log path against the working directory, so running it
# with --project-dir from the repository root writes here instead.
logs/
# dbt writes a machine-local id here for its anonymous usage stats. It is
# per laptop, not per project, so it would conflict on any other machine.
dbt/.user.yml

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Terraform (later projects)
.terraform/
*.tfstate
*.tfstate.*

samples/
